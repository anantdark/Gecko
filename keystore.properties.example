# Local signing for assemble*Release on your machine.
# Copy to keystore.properties and point at your keystore.
#
# CI release signing is configured only via GitHub secrets (RELEASE_*),
# not this file. See DISTRIBUTION.md.
#
# NEVER commit keystore.properties or any .jks file to version control.

storeFile=freescale-release.jks
storePassword=your_store_password
keyAlias=freescale
keyPassword=your_key_password
